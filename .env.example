# Copy to .env and fill in. .env is gitignored.

# Database
DATABASE_URL=postgresql+asyncpg://conduct:conduct@localhost:5432/conduct

# Redis (for RQ — wired up in P4)
REDIS_URL=redis://localhost:6379/0

# Ollama (runs natively on the host, not in docker)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic
ANTHROPIC_API_KEY=

# Admin auth — generate a long random string, e.g. `openssl rand -hex 32`
CONDUCT_ADMIN_KEY=

# Default routing fallbacks
DEFAULT_MODEL=llama3.3:70b
DEFAULT_SENSITIVE_MODEL=llama3.3:70b

# OTel exporter — points at the Watchtower Alloy collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=conduct

# ngrok (wired up in P10)
NGROK_AUTHTOKEN=
