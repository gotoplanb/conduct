# Copy to .env and fill in. .env is gitignored.

# Database
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://conduct:${POSTGRES_PASSWORD}@localhost:5432/conduct

# Redis (for RQ — wired up in P4)
REDIS_URL=redis://localhost:6379/0

# Ollama (runs natively on the host, not in docker)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic
ANTHROPIC_API_KEY=

# Admin auth — generate a long random string, e.g. `openssl rand -hex 32`
CONDUCT_ADMIN_KEY=

# Public HTTPS origin Conduct is reachable at (your tunnel / reverse proxy).
# Used as the OAuth issuer + MCP resource URL for Claude custom connectors.
# Leave as localhost for local dev; set to the public URL in prod.
CONDUCT_PUBLIC_URL=http://localhost:8000

# Default routing fallbacks
DEFAULT_MODEL=llama3.3:70b
DEFAULT_SENSITIVE_MODEL=llama3.3:70b

# OTel exporter — points at the Watchtower Alloy collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=conduct

# Grafana base URL — the UI uses this to build deep-links from a job's
# detail page into the corresponding trace in Tempo. Set to empty to
# suppress the "View trace" link in the UI.
GRAFANA_BASE_URL=http://localhost:3000

# TTS (Piper) — voice files and output directory
TTS_VOICES_DIR=./voices
TTS_DEFAULT_VOICE=en_US-amy-medium
TTS_OUTPUT_DIR=./output
TTS_MAX_CHARS=10000

# ngrok (wired up in P10)
NGROK_AUTHTOKEN=

# SonarQube — generate at http://localhost:9000 → User → My Account → Security
# and paste here. Required for `make sonar-scan`.
SONAR_TOKEN=
